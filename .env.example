# Supabase client config (safe to expose — these are public/publishable values).
# They ship in the JS bundle; isolation is enforced by Supabase Auth + RLS, not by
# hiding them. Set the same variables in Netlify: Site settings -> Environment
# variables.
#
# Both are required. src/integrations/supabase/client.ts constructs the client at
# module-import time with no fallback and no validation, so an unset value crashes
# the app on load rather than degrading.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# Web-push VAPID public key. Read by src/hooks/usePushNotifications.ts:11.
# Optional — if unset, push subscription is skipped and the rest of the app works.
# Note that nothing currently sends to the subscriptions this collects.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# VITE_SUPABASE_PROJECT_ID was listed here but is read nowhere in src/. The
# Supabase CLI takes the project ref from supabase/config.toml (gitignored) or a
# --project-ref flag, not from this file. Removed rather than left to rot.
